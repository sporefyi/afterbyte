# AFTERBYTE backend — environment template. Copy to .env and fill in. No values committed.
# Core missing credentials fail the affected service clearly; optional missing
# providers disable their capabilities. A missing MODEL key must NOT block
# public reads of existing published content.

APP_ENV=dev # dev | staging | production
PUBLIC_SITE_URL=
API_ORIGIN=
ALLOWED_ORIGINS=

DATABASE_URL=
REDIS_URL=
SESSION_SECRET=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET_PUBLIC=
OBJECT_STORAGE_BUCKET_PRIVATE=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=

# Optional research capabilities — absent key disables the capability.
SEARCH_PROVIDER_KEY=
MODEL_PROVIDER_KEY=

# Solana receipt publication (Release A, mainnet after validation).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
RECEIPT_PROGRAM_ID=
PUBLISHER_SIGNER_REFERENCE=

# Payments (Release B) — backend stays disabled until configured + verified.
PAYMENTS_ENABLED=false
TREASURY_PUBLIC_KEY=
USDC_MINT=

# Budgets (integer base units where money-like)
RESEARCH_DAILY_BUDGET=
RESEARCH_MAX_RUN_COST=

# Token utility (Release C) — off until a mint and business rules are selected.
TOKEN_ENABLED=false
TOKEN_MINT=
