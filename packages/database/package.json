{
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "description": "AFTERBYTE backend — Drizzle ORM schema, migrations, seed and db client (Lane 1: database).",
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "main": "./dist/index.js",
  "name": "@afterbyte/database",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "type": "module",
  "types": "./dist/index.js",
  "version": "0.1.0"
}
