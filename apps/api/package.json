{
  "dependencies": {
    "@afterbyte/database": "workspace:*",
    "@afterbyte/observability": "workspace:*",
    "@afterbyte/storage": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "bs58": "6.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "tweetnacl": "1.0.3"
  },
  "description": "AFTERBYTE API — Fastify 5 server, versioned REST + public SSE. Release A scope.",
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./config": "./dist/config.js",
    "./lib/envelope": "./dist/lib/envelope.js",
    "./lib/pagination": "./dist/lib/pagination.js",
    "./services/auth": "./dist/services/auth.service.js",
    "./services/store": "./dist/services/store.js"
  },
  "main": "dist/index.js",
  "name": "@afterbyte/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @afterbyte/api^... build"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.0"
}
